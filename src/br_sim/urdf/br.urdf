  <!-- ==================== 仿真传感器与驱动插件（SLAM 导航用） ==================== -->

  <!-- MID360 激光雷达传感器（360°、40m 量程） -->
  <gazebo reference="mid360_link">
    <sensor name="mid360_lidar" type="ray">
      <pose>0 0 0 0 0 0</pose>
      <always_on>true</always_on>
      <update_rate>10.0</update_rate>
      <ray>
        <scan>
          <horizontal>
            <samples>360</samples>
            <resolution>1</resolution>
            <min_angle>-3.141592653589793</min_angle>
            <max_angle>3.141592653589793</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.15</min>
          <max>40.0</max>
          <resolution>0.01</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </ray>
      <plugin name="mid360_lidar_plugin" filename="libgazebo_ros_ray_sensor.so">
        <ros>
          <remapping>~/out:=/scan</remapping>
        </ros>
        <output_type>sensor_msgs/LaserScan</output_type>
        <frame_name>mid360_link</frame_name>
      </plugin>
    </sensor>
  </gazebo>

  <!-- IMU 惯性测量单元 -->
  <gazebo reference="base_link">
    <!-- 机器人由 planar_move（运动学插件）用 SetLinearVel/SetAngularVel 驱动。
         ODE 的接触摩擦是唯一会「吃掉」设定速度的因素：μ=1.0 时 6 个轮子 +
         底盘大面积贴地，摩擦力矩直接把 SetAngularVel 抹平（实测 wz=1.0 rad/s
         走 3 s，真实 yaw 只变化 0.08 rad）。这里 μ 设为 0，并给较硬的接触参数
         防止零摩擦下回弹/穿刺导致翻车。 -->
    <mu1>0.0</mu1>
    <mu2>0.0</mu2>
    <kp>1000000.0</kp>
    <kd>100.0</kd>
    <minDepth>0.001</minDepth>
    <maxVel>0.1</maxVel>
    <sensor name="imu_sensor" type="imu">
      <always_on>true</always_on>
      <update_rate>100.0</update_rate>
      <plugin name="imu_plugin" filename="libgazebo_ros_imu_sensor.so">
        <ros>
          <remapping>~/out:=/imu</remapping>
        </ros>
        <frame_name>base_link</frame_name>
      </plugin>
    </sensor>
  </gazebo>

  <!-- 全向运动插件：接收 cmd_vel(vx,vy,wz)，发布 odom 和 TF odom->base_link -->
  <gazebo>
    <plugin name="planar_move" filename="libgazebo_ros_planar_move.so">
      <odometry_frame>odom</odometry_frame>
      <robot_base_frame>base_link</robot_base_frame>
      <update_rate>100.0</update_rate>
      <publish_rate>50.0</publish_rate>
      <publish_odom>true</publish_odom>
      <publish_odom_tf>true</publish_odom_tf>
    </plugin>
  </gazebo>

</robot>