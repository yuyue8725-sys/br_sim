        <mesh filename="package://br_sim/urdf/meshes/base_link.STL" />
      </geometry>
      <material name="">
        <color rgba="1 1 1 1" />
      </material>
    </visual>
    <collision>
      <!-- 整机唯一碰撞体：box 底面 -0.055 略低于轮子底面 -0.0517，
           由 box 承重；顶面 0.16 低于雷达（z=0.176），避免雷达被包住。
           只用 box 是为了让 ODE 接触稳定、且不产生锁死旋转的摩擦扭矩。 -->
      <origin xyz="0 0 0.0525" rpy="0 0 0" />
      <geometry>
        <box size="0.62 0.72 0.215" />
      </geometry>
    </collision>
  </link>
