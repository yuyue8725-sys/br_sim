  <link name="base_link">
    <inertial>
      <origin xyz="-0.0104941874573322 0.00894120214595673 0.0153316280803506" rpy="0 0 0" />
      <mass value="4.12809976768818" />
      <inertia ixx="0.01469692224257" ixy="2.17307215639738E-08" ixz="2.36745227382626E-07" iyy="0.0127991164282382" iyz="-6.69960226830507E-06" izz="0.0270682217010851" />
